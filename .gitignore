# env files
# NOTE: .next/ manifests inline build-time env values (including
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY and the preview-mode signing keys),
# which is why /.next/ above matters as much as these do.
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python tooling for content scripts
__pycache__/
*.py[cod]
.venv/
venv/

# supabase local
/supabase/.branches
/supabase/.temp
